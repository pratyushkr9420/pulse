# ==============================================================================
# PULSE PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.prod and fill in the required values
# Usage: docker-compose -f docker/docker-compose.prod.yml --env-file .env.prod up -d
# ==============================================================================
# Legend:
#   [REQUIRED] - Must be set for application to start
#   [OPTIONAL] - Has sensible defaults, can be omitted
#   [OPTIONAL-FEATURE] - Only needed if using that feature
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
APP_NAME="Pulse API"
DEBUG=false
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# API SERVER [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Update CORS_ORIGINS to match your frontend URL
# For local deployment (same machine): http://localhost:3000
# For production: https://your-production-frontend.com
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE [REQUIRED]
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production
# Format: postgresql+asyncpg://user:password@host:port/database
# For Docker: use service name 'postgres' as host
DATABASE_URL=postgresql+asyncpg://stocknews:CHANGE_THIS_PASSWORD@postgres:5432/stocknews

# Database connection parameters (used by docker-entrypoint.sh for service health checks)
# For Docker: use service name 'postgres' as host
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# REDIS [OPTIONAL - has default, needed for caching/rate limiting]
# ------------------------------------------------------------------------------
# For Docker: use service name 'redis' as host
REDIS_URL=redis://redis:6379/0

# Redis connection parameters (used by docker-entrypoint.sh for service health checks)
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# QDRANT VECTOR DATABASE [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
# For Docker: use service name 'qdrant' as host
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=stock_news

# ------------------------------------------------------------------------------
# OPENAI [REQUIRED]
# ------------------------------------------------------------------------------
# Your OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-production-key-here
# Model choices (optional, have defaults)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION [REQUIRED]
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-generated-secret-key-here
# Optional JWT settings (have defaults)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# OBSERVABILITY [OPTIONAL-FEATURE]
# These are only needed if you want to enable the respective features.
# The application works fine without them.
# ------------------------------------------------------------------------------

# Sentry Error Tracking (https://sentry.io)
# Leave empty to disable Sentry
SENTRY_DSN=

# LangSmith LLM Tracing (https://smith.langchain.com)
# Leave empty to disable LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulse-prod

# Prometheus Metrics (https://prometheus.io)
# Set to 'true' to enable metrics at /metrics endpoint
# Set to 'false' or leave empty to disable metrics
ENABLE_METRICS=true

# ------------------------------------------------------------------------------
# FRONTEND [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
# CRITICAL: NEXT_PUBLIC_* variables are embedded in the frontend at BUILD TIME
# These must be set BEFORE building the Docker images

# API URL that the user's BROWSER will use to connect to the backend
# IMPORTANT: This must be accessible from the user's browser, not just Docker network
#
# Choose the appropriate URL for your deployment:
#   - Same host (localhost):        http://localhost:8000
#   - External access:              http://YOUR_SERVER_IP:8000  (e.g., http://192.168.1.100:8000)
#   - Production domain (HTTPS):    https://api.yourdomain.com
#
# ⚠️  DO NOT USE Docker service names (e.g., http://backend:8000)
#     Browser cannot resolve Docker internal network names!
#
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application name displayed in the UI
NEXT_PUBLIC_APP_NAME=Pulse
