# ==============================================================================
# PULSE FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.production and update values for your production setup
# ==============================================================================

# Backend API URL - CRITICAL: This must be accessible from the USER'S BROWSER
#
# IMPORTANT: NEXT_PUBLIC_* variables are embedded at BUILD TIME into the
# JavaScript bundle. The browser will use this exact URL to make API calls.
#
# Choose the appropriate URL for your deployment:
#
# Option 1: Single-host deployment (Docker on one server, access from same server)
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Option 2: External access (Docker on server, access from different machines)
#   NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000
#   Example: NEXT_PUBLIC_API_URL=http://192.168.1.100:8000
#
# Option 3: Production domain with reverse proxy (RECOMMENDED)
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#   or NEXT_PUBLIC_API_URL=https://yourdomain.com/api
#
# ⚠️  DO NOT USE Docker service names (e.g., http://backend:8000)
#     Browser cannot resolve Docker internal network names!
#
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Name
NEXT_PUBLIC_APP_NAME=Pulse
