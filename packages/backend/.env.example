# ==============================================================================
# PULSE BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Legend:
#   [REQUIRED] - Must be set for application to start
#   [OPTIONAL] - Has sensible defaults, can be omitted
#   [OPTIONAL-FEATURE] - Only needed if using that feature
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
APP_NAME=Pulse API
DEBUG=false
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# API SERVER [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE [REQUIRED]
# ------------------------------------------------------------------------------
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://stocknews:stocknews@localhost:5432/stocknews

# ------------------------------------------------------------------------------
# REDIS [OPTIONAL - has default, needed for caching/rate limiting]
# ------------------------------------------------------------------------------
# If not using Redis, some features (caching, rate limiting) will be disabled
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# QDRANT VECTOR DATABASE [OPTIONAL - have defaults]
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=stock_news

# ------------------------------------------------------------------------------
# OPENAI [REQUIRED]
# ------------------------------------------------------------------------------
# Your OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here
# Model choices (optional, have defaults)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION [REQUIRED]
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
# Optional JWT settings (have defaults)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# OBSERVABILITY [OPTIONAL-FEATURE]
# These are only needed if you want to enable the respective features.
# The application works fine without them.
# ------------------------------------------------------------------------------

# Sentry Error Tracking (https://sentry.io)
# Leave empty to disable Sentry
SENTRY_DSN=

# LangSmith LLM Tracing (https://smith.langchain.com)
# Leave empty to disable LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulse

# Note: Prometheus metrics are always enabled at /metrics endpoint
# No additional configuration needed - uses prometheus-fastapi-instrumentator
